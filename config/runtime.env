# Non-secret runtime configuration, committed to git (unlike .env, which
# holds credentials and is gitignored). Loaded after .env with override=True
# for exactly these keys -- see src/env.py:load_env(). Vertex AI auth comes
# from Application Default Credentials (gcloud auth application-default
# login), not a key in this file.

GEMINI_PROVIDER=vertex
GOOGLE_CLOUD_PROJECT=just-rhythm-506202-j8
GOOGLE_CLOUD_LOCATION=global
BULK_SPEND_CAP_USD=260
