# Secrets for the Python pipeline. Copy to .env and fill in; never
# commit the filled-in file. Non-secret runtime config (which provider,
# GCP project/location, spend caps) lives in config/runtime.env instead
# and is already committed -- see src/env.py.

# Local Postgres (or Supabase) connection string.
DATABASE_URL=

# Only needed if GEMINI_PROVIDER=aistudio (config/runtime.env currently
# sets it to "vertex", which authenticates via Application Default
# Credentials instead -- run `gcloud auth application-default login`
# and this key isn't used at all).
GEMINI_API_KEY=
