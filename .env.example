# Secrets for the Python pipeline. Copy to .env and fill in; never
# commit the filled-in file. Non-secret runtime config (which provider,
# GCP project/location, spend caps) lives in config/runtime.env instead
# and is already committed -- see src/env.py.

# Local Postgres (or Supabase) connection string.
DATABASE_URL=

# Only needed if GEMINI_PROVIDER=aistudio (config/runtime.env currently
# sets it to "vertex", which authenticates via Application Default
# Credentials instead -- run `gcloud auth application-default login`
# and this key isn't used at all).
GEMINI_API_KEY=

# apps/web reads this one too (see apps/web/src/lib/db.ts, which loads
# this same root .env). Set to exactly "true" to enable /review and
# /review/[slug] locally -- left unset in production (Vercel), so the
# review queue 404s there. See apps/web/src/proxy.ts.
REVIEW_ENABLED=

# Same pattern as REVIEW_ENABLED, for /crosscheck and /crosscheck/[ticker]
# (and the /api/crosscheck/[ticker] route behind them) -- these read
# companies/earnings_company_reports/earnings_quarter_calculations/
# guidance_versions/earnings_actuals over DATABASE_URL, tables that
# aren't in Supabase yet (see supabase/crosscheck_public.sql). Set to
# exactly "true" to enable them locally; leave unset in production until
# that SQL has been run. /crosscheck/predictions is NOT gated by this --
# it reads a separate, already-public snapshot (CROSSCHECK_PUBLISHED_DATABASE_URL
# below) and stays reachable either way.
CROSSCHECK_RESEARCH_ENABLED=

# Dedicated, read-only connection for /crosscheck/predictions -- see
# apps/web/src/lib/crosscheck/predictions/read.ts. Never the same value
# as DATABASE_URL; must authenticate as dealtrace_web. Unset locally is
# fine (the page shows "No published snapshot is available" instead of
# erroring -- see supabase/crosscheck_public.sql for what this should
# point at once published_snapshots.sql has been run).
CROSSCHECK_PUBLISHED_DATABASE_URL=
