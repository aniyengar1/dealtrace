# Env vars apps/web needs in production. Copy to .env (repo root, not
# this directory -- see src/lib/db.ts) and fill in real values; never
# commit the filled-in file.

# Postgres connection string. In production, Supabase's transaction
# pooler URL (port 6543).
DATABASE_URL=

# Public base URL used to build absolute links in the sitemap and page
# metadata (e.g. https://dealtrace.example). Falls back to
# http://localhost:3000 if unset.
SITE_URL=

# Set to exactly "true" to enable /review and /review/[slug] locally.
# Leave unset in production (Vercel) -- the review queue 404s there.
# See apps/web/src/proxy.ts.
REVIEW_ENABLED=
